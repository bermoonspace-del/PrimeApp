});

document.getElementById('btn-add-zone').addEventListener('click', ()=>{
  const id = `zone-${state.zones.length+1}`;
  const z = {zone:id, label:`Зона ${state.zones.length+1}`, x:100, y:100, width:300, height:200, rx:12, _id:`z${nextZoneId++}`};
  state.zones.push(z);
  selectZone(z._id);
  toast('Зона создана — перетащи и растяни');
});
document.getElementById('btn-new-club').addEventListener('click', ()=>{
  const name = prompt('Имя папки клуба (латиница, без пробелов, напр. MYCLUB):');
  if(!name) return;
  if(!/^[a-zA-Z0-9_\-]{1,64}$/.test(name)) return toast('Недопустимое имя');
  state.club = name;
  els.clubName.value = name;
  updateClubPath();
  state.blocks={};
  state.zones=[];
  state.origin=[0,0];
  state.viewBox=[720,1280];
  els.vbW.value=720; els.vbH.value=1280; els.originX.value=0; els.originY.value=0;
  updateBlockSelectors();
