});

document.getElementById('btn-add-pc').addEventListener('click', ()=>{
  if(Object.keys(state.blocks).length===0){
    if(!confirm('Нет блоков. Создать блок автоматически?')) return;
    state.blocks['block_1']={origin:[100,100], step:70, stepY:70, pcs:{}};
    updateBlockSelectors();
  }
  // open modal
  // set next free number
  const allNums = getAllPCs().map(p=> Number(p.num)).filter(n=>Number.isFinite(n));
  const next = allNums.length ? Math.max(...allNums)+1 : 1;
  document.getElementById('new-pc-num').value = next;
  updateBlockSelectors();
  document.getElementById('modal-new-pc').classList.add('open');
});
document.getElementById('new-pc-cancel').addEventListener('click', ()=> document.getElementById('modal-new-pc').classList.remove('open'));
document.getElementById('new-pc-create').addEventListener('click', ()=>{
  const num = String(document.getElementById('new-pc-num').value.trim());
  const blockName = document.getElementById('new-pc-block').value;
  const col = Number(document.getElementById('new-pc-col').value)||0;
  const row = Number(document.getElementById('new-pc-row').value)||0;
  if(!num) return toast('Номер обязателен');
  if(findPCByNum(num)) return toast('ПК уже существует');
  const block = state.blocks[blockName];
  if(!block) return toast('Выбери блок');
  block.pcs[num] = [col,row];
