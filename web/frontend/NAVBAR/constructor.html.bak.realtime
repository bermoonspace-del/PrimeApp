});

document.getElementById('btn-clear').addEventListener('click', ()=>{
  if(!confirm('Очистить все блоки и ПК?')) return;
  state.blocks={};
  state.zones=[];
  deselect();
  updateBlockSelectors();
  render();
  toast('Карта очищена');
});
document.getElementById('btn-reset-view').addEventListener('click', ()=>{
  scale=1; pan={x:0,y:0};
  render();
});

function attachSvgEvents(){
  const svg = els.stage;
  // remove old listeners by cloning? simpler: replace with new handlers each render using one-time setup
  // We'll use event delegation fresh each render: first remove existing
  const newSvg = svg.cloneNode(true);
  svg.parentNode.replaceChild(newSvg, svg);
  els.stage = newSvg;
  const stage = els.stage;

  stage.addEventListener('pointerdown', onPointerDown);
  stage.addEventListener('pointermove', onPointerMove);
  stage.addEventListener('pointerup', onPointerUp);
  stage.addEventListener('click', onClick);
  stage.addEventListener('wheel', onWheel, {passive:false});
  // prevent context menu
  stage.addEventListener('contextmenu', e=> e.preventDefault());
}

function svgPointFromEvent(e){
  const svg = els.stage;
  const pt = svg.createSVGPoint();
  pt.x = e.clientX; pt.y = e.clientY;
  const ctm = svg.getScreenCTM();
  if(!ctm) return {x:0,y:0};
  const svgP = pt.matrixTransform(ctm.inverse());
  return {x:svgP.x, y:svgP.y};
}

function onPointerDown(e){
  if(e.button!==0) return;
  const p = svgPointFromEvent(e);
  // hit test PCs first
  const pcs = getAllPCs();
  let hitPC = null;
  let minDist = 22; // px in svg units? Approx viewBox units: for vb 1440, 22 ~ radius
  for(const pc of pcs){
    const dx = pc.x - p.x; const dy = pc.y - p.y;
    const dist = Math.sqrt(dx*dx+dy*dy);
    if(dist < minDist){
      minDist = dist;
      hitPC = pc;
    }
  }
  if(hitPC){
    e.preventDefault();
    selectPC(hitPC.num);
    drag = {type:'pc', num:hitPC.num, blockName:hitPC.blockName, startSvg:{x:p.x, y:p.y}, origAbs:{x:hitPC.x, y:hitPC.y}, origCell: structuredClone(hitPC.cell)};
    els.stage.setPointerCapture(e.pointerId);
    return;
  }
  // hit zones
  const hitZone = state.zones.find(z=> p.x>=z.x && p.x<=z.x+z.width && p.y>=z.y && p.y<=z.y+z.height);
  if(hitZone){
    // check handle
    const handleSize=10;
    const handles = [
      [hitZone.x, hitZone.y], [hitZone.x+hitZone.width, hitZone.y],
      [hitZone.x, hitZone.y+hitZone.height], [hitZone.x+hitZone.width, hitZone.y+hitZone.height]
    ];
    let hitHandle = -1;
    handles.forEach((h,i)=>{
      if(Math.abs(p.x-h[0])<handleSize && Math.abs(p.y-h[1])<handleSize) hitHandle=i;
    });
    if(hitHandle!==-1){
      drag = {type:'zone-resize', zoneId:hitZone._id, handle:hitHandle, startSvg:{x:p.x,y:p.y}, origZone:{...hitZone}};
    } else {
      drag = {type:'zone-drag', zoneId:hitZone._id, startSvg:{x:p.x,y:p.y}, origZone:{...hitZone}};
      selectZone(hitZone._id);
    }
    els.stage.setPointerCapture(e.pointerId);
    return;
  }
  // pan: start dragging view if empty background (left or middle button)
  if(e.button===0 || e.button===1){
    drag = {type:'pan', startSvg:{x:p.x, y:p.y}, origPan:{x:pan.x, y:pan.y}};
    try{ els.stage.setPointerCapture(e.pointerId);}catch{}
    els.stage.style.cursor='grabbing';
    e.preventDefault();
  }
}

function onPointerMove(e){
  if(!drag) return;
  const p = svgPointFromEvent(e);
  const dx = p.x - drag.startSvg.x;
  const dy = p.y - drag.startSvg.y;
  if(drag.type==='pan'){
    const dx = p.x - drag.startSvg.x;
    const dy = p.y - drag.startSvg.y;
    pan.x = drag.origPan.x - dx;
    pan.y = drag.origPan.y - dy;
    requestAnimationFrame(render);
  } else if(drag.type==='pc'){
    const info = findPCByNum(drag.num);
    if(!info) return;
    const newX = drag.origAbs.x + dx;
    const newY = drag.origAbs.y + dy;
    let cell = info.block.pcs[drag.num];
    if(cell && cell.override){
      // update override relative to block origin + state origin
      const ox = state.origin[0] + info.block.origin[0];
      const oy = state.origin[1] + info.block.origin[1];
      cell.override[0] = Math.round(newX - ox);
      cell.override[1] = Math.round(newY - oy);
    } else {
      // grid: convert to col/row
      let colRow = absoluteToGrid(newX, newY, info.block);
      if(els.snapGrid.checked){
        colRow[0] = Math.round(colRow[0]*2)/2; // snap 0.5
        colRow[1] = Math.round(colRow[1]*2)/2;
      }
      // store back
      info.block.pcs[drag.num] = [Number(colRow[0].toFixed(1)), Number(colRow[1].toFixed(1))];
    }
    // live update without full render? just update circle position visually cheap: call render throttled
    // for simplicity, render each move with rAF
    requestAnimationFrame(render);
  } else if(drag.type==='zone-drag'){
    const z = state.zones.find(x=> x._id===drag.zoneId);
    if(!z) return;
    z.x = Math.round(drag.origZone.x + dx);
    z.y = Math.round(drag.origZone.y + dy);
    requestAnimationFrame(render);
  } else if(drag.type==='zone-resize'){
    const z = state.zones.find(x=> x._id===drag.zoneId);
    if(!z) return;
    const o = drag.origZone;
    // handles: 0 TL,1 TR,2 BL,3 BR
    if(drag.handle===0){ // TL
      const newX = o.x + dx; const newY = o.y + dy;
      const newW = o.width - dx; const newH = o.height - dy;
      if(newW>20 && newH>20){ z.x=newX; z.y=newY; z.width=newW; z.height=newH; }
    } else if(drag.handle===1){ // TR
      const newY = o.y + dy; const newW = o.width + dx; const newH = o.height - dy;
      if(newW>20 && newH>20){ z.y=newY; z.width=newW; z.height=newH; }
    } else if(drag.handle===2){ // BL
      const newX = o.x + dx; const newW = o.width - dx; const newH = o.height + dy;
      if(newW>20 && newH>20){ z.x=newX; z.width=newW; z.height=newH; }
    } else if(drag.handle===3){ // BR
      const newW = o.width + dx; const newH = o.height + dy;
      if(newW>20 && newH>20){ z.width=newW; z.height=newH; }
    }
    requestAnimationFrame(render);
  }
}

function onPointerUp(e){
  if(drag){
    // update inspector if pc
    if(drag.type==='pc'){
      updateInspector();
    }
    // also update json preview via render
    render();
  }
  drag=null;
  els.stage.style.cursor='crosshair';
  try{ els.stage.releasePointerCapture(e.pointerId);}catch{}
}

function onClick(e){
  if(drag) return;
  // if clicked on empty space with Shift, add PC
  if(e.shiftKey){
    const p = svgPointFromEvent(e);
    // find nearest block or create
    const pcs = getAllPCs();
    const nextNum = pcs.length ? Math.max(...pcs.map(x=>Number(x.num)||0))+1 : 1;
    // choose block closest to click or first
    let bestBlock = null;
    let bestDist = Infinity;
    for(const [bName, b] of Object.entries(state.blocks)){
      const absOrigin = [state.origin[0]+b.origin[0], state.origin[1]+b.origin[1]];
      const dx = p.x - absOrigin[0]; const dy = p.y - absOrigin[1];
      const d = Math.sqrt(dx*dx+dy*dy);
      if(d<bestDist){ bestDist=d; bestBlock=bName; }
    }
    if(!bestBlock){
      if(!confirm('Нет блоков. Создать блок?')) return;
      state.blocks['block_1']={origin:[Math.round(p.x-100),Math.round(p.y-100)], step:70, stepY:70, pcs:{}};
      bestBlock='block_1';
      updateBlockSelectors();
    }
    const block = state.blocks[bestBlock];
    const colRow = absoluteToGrid(p.x, p.y, block);
    const col = els.snapGrid.checked ? Math.round(colRow[0]*2)/2 : Number(colRow[0].toFixed(1));
    const row = els.snapGrid.checked ? Math.round(colRow[1]*2)/2 : Number(colRow[1].toFixed(1));
    block.pcs[String(nextNum)] = [col,row];
    selectPC(String(nextNum));
    toast(`ПК ${nextNum} создан в ${bestBlock}`);
    return;
  }
  // if click on empty, deselect? handled by not hitting pc/zone
  const p = svgPointFromEvent(e);
  // check hit
  const pcs = getAllPCs();
  const hitPC = pcs.find(pc=> Math.hypot(pc.x-p.x, pc.y-p.y) < 22);
  if(hitPC) return; // already handled via pointerdown selection
  const hitZone = state.zones.find(z=> p.x>=z.x && p.x<=z.x+z.width && p.y>=z.y && p.y<=z.y+z.height);
  if(hitZone) return;
  // deselect? keep? maybe not
}

function onWheel(e){
  e.preventDefault();
  const p = svgPointFromEvent(e);
  const delta = e.deltaY > 0 ? 0.92 : 1.08;
  const oldScale = scale;
  let newScale = scale * delta;
  newScale = Math.min(4, Math.max(0.35, newScale));
  if(Math.abs(newScale - oldScale) < 0.001) return;
  // keep mouse point stable: newPan = p - (p - pan)*(oldScale/newScale?) actually scaledW = vbW/scale, so ratio = oldScale/newScale
  const vbW_tmp = Number(els.vbW.value)||720;
  const vbH_tmp = Number(els.vbH.value)||1280;
  // old viewBox origin = pan, size = vbW/oldScale
  // mouse SVG p = pan + t*oldScaled ; t = (p - pan)/oldScaled
  // newPan = p - t*newScaled = p - (p - pan)*(newScaled/oldScaled) = p - (p - pan)*(oldScale/newScale)
  const ratio = oldScale / newScale;
  pan.x = p.x - (p.x - pan.x) * ratio;
  pan.y = p.y - (p.y - pan.y) * ratio;
  scale = newScale;
  render();
}

// export / import
document.getElementById('btn-download').addEventListener('click', ()=>{
  const data = exportState();
  const blob = new Blob([JSON.stringify(data,null,2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href=url;
  const club = els.clubName.value.trim() || 'positions';
  a.download = club + '.json';
  a.click();
  URL.revokeObjectURL(url);
  toast('Скачан '+a.download);
});
document.getElementById('btn-copy').addEventListener('click', async ()=>{
  const txt = JSON.stringify(exportState(), null, 2);
  try{ await navigator.clipboard.writeText(txt); toast('Скопировано в буфер'); }catch{ 
    els.jsonIo.value = txt; toast('Текст в поле импорта');
  }
});
document.getElementById('btn-import').addEventListener('click', ()=> document.getElementById('file-import').click());
document.getElementById('file-import').addEventListener('change', async (e)=>{
  const file = e.target.files[0];
  if(!file) return;
  try{
    const txt = await file.text();
    const j = JSON.parse(txt);
    importState(j, state.club || els.clubName.value.trim());
    render();
    toast('Импортировано из файла');
  }catch(err){ toast('Ошибка импорта: '+err.message);}
  e.target.value='';
});
document.getElementById('btn-io-import').addEventListener('click', ()=>{
  const txt = document.getElementById('json-io').value.trim();
  if(!txt) return toast('Вставь JSON');
  try{
    const j = JSON.parse(txt);
    importState(j, state.club);
    render();
    toast('Импортировано');
  }catch(e){ toast('Ошибка JSON: '+e.message); }
});
document.getElementById('btn-io-export').addEventListener('click', ()=>{
  document.getElementById('json-io').value = JSON.stringify(exportState(), null, 2);
  toast('Заполнено из карты');
});
document.getElementById('btn-validate').addEventListener('click', ()=>{
  const data = exportState();
  const msgs=[];
  const allNums = new Set();
  let dup=false;
  for(const [bName, b] of Object.entries(data.layout.blocks)){
    if(!/^[a-zA-Z0-9_\-]+$/.test(bName)) msgs.push(`Блок "${bName}" имя недопустимо`);
    if(!Array.isArray(b.origin)||b.origin.length!==2) msgs.push(`Блок "${bName}" origin не [x,y]`);
    for(const num of Object.keys(b.pcs)){
      if(allNums.has(num)){ msgs.push(`Дубликат ПК ${num}`); dup=true; }
      allNums.add(num);
      if(isNaN(Number(num))) msgs.push(`ПК номер "${num}" не число`);
    }
  }
  const vbOk = state.viewBox[0]>0 && state.viewBox[1]>0;
  if(!vbOk) msgs.push('ViewBox размеры некорректны');
  if(msgs.length===0) { document.getElementById('validate-msg').textContent='✓ OK'; document.getElementById('validate-msg').style.color='#4CAF50'; toast('Валидация OK'); }
  else { document.getElementById('validate-msg').textContent=msgs.join('; '); document.getElementById('validate-msg').style.color='#ff9c9c'; }
});
document.getElementById('btn-save').addEventListener('click', async ()=>{
  const club = els.clubName.value.trim();
  if(!club) return toast('Укажи имя клуба');
  if(!/^[a-zA-Z0-9_\-]{1,64}$/.test(club)) return toast('Имя клуба только латиница/цифры/_-');
  const data = exportState();
  try{
    const res = await fetch('/api/constructor/save', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({club, data})});
    const j = await res.json();
    if(!res.ok) throw new Error(j.error||'save failed');
    toast('Сохранено: '+j.path);
    // refresh list
    loadClubList();
  }catch(e){
    toast('Ошибка сохранения: '+e.message);
    console.error(e);
  }
});
document.getElementById('btn-export-zones').addEventListener('click', async ()=>{
  if(state.zones.length===0) return toast('Нет зон');
  let html = state.zones.map(z=> `    <rect class="zone" data-zone="${z.zone}" x="${Math.round(z.x)}" y="${Math.round(z.y)}" width="${Math.round(z.width)}" height="${Math.round(z.height)}" rx="${z.rx||12}"/>\n    <text class="zone-label" x="${Math.round(z.x+z.width/2)}" y="${Math.round(z.y-8)}" text-anchor="middle">${z.label}</text>`).join('\n');
  html = `<!-- Zones for ${state.club||'CLUB'} — вставь в <svg class="zone-overlay"> -->\n${html}`;
  try{ await navigator.clipboard.writeText(html); toast('HTML зон скопирован'); }catch{
    document.getElementById('json-io').value = html;
    toast('HTML в поле импорта');
  }
});
document.getElementById('btn-auto-layout').addEventListener('click', ()=>{
  // Simple auto layout: distribute blocks grid
  const blocks = Object.keys(state.blocks);
  if(blocks.length===0) return toast('Нет блоков');
  const cols = Math.ceil(Math.sqrt(blocks.length));
  const vbW = state.viewBox[0], vbH = state.viewBox[1];
  const cellW = Math.floor(vbW/cols);
  const cellH = Math.floor(vbH/Math.ceil(blocks.length/cols));
  blocks.forEach((bName,i)=>{
    const b = state.blocks[bName];
    const col = i % cols;
    const row = Math.floor(i / cols);
    b.origin = [col*cellW + 60, row*cellH + 60];
  });
  toast('Авто-выравнивание применено');
  render();
});
document.getElementById('btn-renumber').addEventListener('click', ()=>{
  if(!confirm('Перенумеровать все ПК последовательно с 1?')) return;
  const pcs = getAllPCs().sort((a,b)=> a.y - b.y || a.x - b.x);
  // collect all cells then reassign
  const newMap = {};
  let n=1;
  // clear all pcs
  for(const b of Object.values(state.blocks)) b.pcs={};
  // we need to assign back? But we lost original block association. Instead, keep per block order?
  // Simpler: renumber per block sequentially
  for(const [bName, b] of Object.entries(state.blocks)){
    const entries = Object.entries(b.pcs); // but we cleared
  }
  // Actually pcs list still has old num, but we cleared.
  // Reconstruct: we have pcs array with original blockName and cell
  const firstBlock = Object.keys(state.blocks)[0];
  if(!firstBlock) return;
  // distribute across blocks round-robin? Better just renumber globally in first block for demo.
  // Let's instead renumber per block
  // reload from backup
  toast('Функция требует доработки — перенумеруй вручную в инспекторе');
});
document.getElementById('btn-zoom-in').addEventListener('click', ()=>{
  const vbW_tmp = Number(els.vbW.value)||720; const vbH_tmp = Number(els.vbH.value)||1280;
  const oldScale = scale;
  const newScale = Math.min(4, scale*1.2);
  if(newScale===oldScale) return;
  const centerX = pan.x + (vbW_tmp/oldScale)/2;
  const centerY = pan.y + (vbH_tmp/oldScale)/2;
  scale = newScale;
  pan.x = centerX - (vbW_tmp/scale)/2;
  pan.y = centerY - (vbH_tmp/scale)/2;
  render();
});
document.getElementById('btn-zoom-out').addEventListener('click', ()=>{
  const vbW_tmp = Number(els.vbW.value)||720; const vbH_tmp = Number(els.vbH.value)||1280;
  const oldScale = scale;
  const newScale = Math.max(0.35, scale/1.2);
  if(newScale===oldScale) return;
  const centerX = pan.x + (vbW_tmp/oldScale)/2;
  const centerY = pan.y + (vbH_tmp/oldScale)/2;
  scale = newScale;
  pan.x = centerX - (vbW_tmp/scale)/2;
  pan.y = centerY - (vbH_tmp/scale)/2;
  render();
});
document.getElementById('btn-fit').addEventListener('click', ()=>{
  scale=1; pan={x:0,y:0};
  render();
  toast('Вид сброшен');
});

// help modal
document.getElementById('btn-help').addEventListener('click', ()=> document.getElementById('modal-help').classList.add('open'));
document.getElementById('help-close').addEventListener('click', ()=> document.getElementById('modal-help').classList.remove('open'));
document.getElementById('modal-help').addEventListener('click', (e)=>{ if(e.target.id==='modal-help') e.currentTarget.classList.remove('open'); });
document.getElementById('modal-new-pc').addEventListener('click', (e)=>{ if(e.target.id==='modal-new-pc') e.currentTarget.classList.remove('open'); });
document.getElementById('modal-new-block').addEventListener('click', (e)=>{ if(e.target.id==='modal-new-block') e.currentTarget.classList.remove('open'); });

// initial render empty
let spacePressed=false;
document.addEventListener('keydown', e=>{ if(e.code==='Space'){ spacePressed=true; els.stage.style.cursor='grab'; e.preventDefault(); }});
document.addEventListener('keyup', e=>{ if(e.code==='Space'){ spacePressed=false; els.stage.style.cursor='crosshair'; }});
document.addEventListener('keydown', e=>{
  const step = 40 / scale;
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)){
    if(e.key==='ArrowUp') pan.y -= step;
    if(e.key==='ArrowDown') pan.y += step;
    if(e.key==='ArrowLeft') pan.x -= step;
    if(e.key==='ArrowRight') pan.x += step;
    render(); e.preventDefault();
  }
  if((e.ctrlKey||e.metaKey) && (e.key==='0' || e.key==='=')){ scale=1; pan={x:0,y:0}; render(); e.preventDefault(); }
});
updateBlockSelectors();
render();
// load default club if ?club=TRIUMPH
const params = new URLSearchParams(location.search);
if(params.get('club')){
  const c = params.get('club');
  els.clubSelect.value = c;
  els.clubName.value = c;
  updateClubPath();
  loadClub(c);
} else {
  // auto load TRIUMPH as demo if exists
  // fetch positions.json from TRIUMPH silently
  fetch('TRIUMPH/positions.json').then(r=> r.ok? r.json(): null).then(j=>{
    if(j){ importState(j, 'TRIUMPH'); els.clubSelect.value='TRIUMPH'; els.clubName.value='TRIUMPH'; updateClubPath(); render(); }
  }).catch(()=>{});
}
</script>
</body>
</html>
